// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "windows", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  password    String
  token       String?       @unique @default(uuid())
  name        String
  surname     String
  sex         Sex?
  weight      Int?
  height      Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  UserDisease UserDisease[]
  Data        Data[]
  Calendar    Calendar[]

  @@map("users")
}

enum Sex {
  MALE
  FEMALE
}

model Disease {
  id          Int           @id @default(autoincrement())
  diseaseName String
  diseaseType String
  UserDisease UserDisease[]

  @@map("disease")
}

model UserDisease {
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  disease   Disease  @relation(fields: [diseaseId], references: [id])
  diseaseId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, diseaseId])
  @@map("userDisease")
}

model Data {
  id          Int      @id @default(autoincrement())
  dataType    DataType
  value       Float?
  pressure    String?
  description String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int

  @@map("data")
}

enum DataType {
  EXERCISE
  MEDICATION

  GLUCOSE
  CARBS
  INSULIN

  PAS
  PAD
  HEART_RATE
}

model Calendar {
  id          Int       @id @default(autoincrement())
  event       String
  description String?
  date        DateTime
  type        EventType
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("calendar")
}

enum EventType {
  DIABETES
  HYPERTENSION
  EXERCISE
  MEDICATION
  OTHER
}
