generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "windows", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  password    String
  token       String?       @unique @default(uuid())
  name        String
  surname     String
  sex         Sex?
  weight      Int?
  height      Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Calendar    Calendar[]
  Data        Data[]
  UserDisease UserDisease[]

  @@map("users")
}

model Disease {
  id          Int           @id @default(autoincrement())
  diseaseName String
  diseaseType String
  UserDisease UserDisease[]

  @@map("disease")
}

model UserDisease {
  userId    Int
  diseaseId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  disease   Disease  @relation(fields: [diseaseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, diseaseId])
  @@map("userDisease")
}

model Data {
  id          Int      @id @default(autoincrement())
  dataType    DataType
  value       Float
  description String?
  createdAt   DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  @@map("data")
}

model Calendar {
  id          Int       @id @default(autoincrement())
  event       String
  description String?
  date        DateTime
  type        EventType
  userId      Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])

  @@map("calendar")
}

enum Sex {
  MALE
  FEMALE
}

enum DataType {
  EXERCISE
  MEDICATION
  GLUCOSE
  CARBS
  INSULIN
  PAS
  HEART_RATE
  PAD
}

enum EventType {
  DIABETES
  HYPERTENSION
  EXERCISE
  MEDICATION
  OTHER
}
